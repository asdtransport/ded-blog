---
import BaseLayout from "./BaseLayout.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import PrevNext from "../components/docs/PrevNext.astro";

interface Props {
  title: string;
  description: string;
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
  updatedDate?: Date;
}

const { title, description, slug, headings, updatedDate } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={`${title} — Docs`} description={description}>
  <div class="docs-shell">
    <DocsSidebar />

    <main class="docs-main">
      <article class="prose docs-prose">
        <div class="docs-eyebrow">Docs</div>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        {updatedDate && <p class="docs-updated">Updated {fmt(updatedDate)}</p>}
        <hr />
        <slot />
      </article>
      <PrevNext slug={slug} />
    </main>

    <aside class="docs-toc-column">
      {headings.length > 0 && (
        <div class="docs-toc-sticky">
          <TableOfContents headings={headings} />
        </div>
      )}
    </aside>
  </div>
</BaseLayout>

<style is:global>
  /* ─── Docs shell ─────────────────────────────────── */
  .docs-shell {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) 240px;
    gap: 48px;
    padding: 32px 32px 80px;
    align-items: start;
  }

  /* Sidebar */
  .docs-sidebar {
    position: sticky;
    top: 88px;
    align-self: start;
    font-size: 14px;
    border-right: 1px solid var(--border);
    padding-right: 24px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }
  .docs-sidebar-header {
    display: flex; align-items: baseline; justify-content: space-between;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 16px;
  }
  .docs-sidebar-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .docs-sidebar-title:hover { text-decoration: none; color: var(--brand); }
  .docs-sidebar-back {
    color: var(--text-muted);
    font-size: 12px;
  }
  .docs-sidebar-group { margin-bottom: 20px; }
  .docs-sidebar-group-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-subtle);
    margin: 0 0 6px;
    padding: 0 4px;
  }
  .docs-sidebar-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .docs-sidebar-group li { margin: 0; }
  .docs-sidebar-link {
    display: block;
    padding: 5px 10px;
    color: var(--text-muted);
    border-radius: 4px;
    margin: 1px 0;
    font-size: 13.5px;
    line-height: 1.4;
  }
  .docs-sidebar-link:hover {
    background: var(--bg-tint);
    color: var(--text);
    text-decoration: none;
  }
  .docs-sidebar-link.active {
    color: var(--brand);
    background: rgba(15,118,110,0.08);
    font-weight: 600;
  }
  .docs-sidebar-footer {
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12px;
  }
  .docs-sidebar-footer a { color: var(--text-muted); }

  /* Main content */
  .docs-main {
    min-width: 0;
  }
  .docs-prose {
    max-width: 720px;
  }
  .docs-eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 8px;
  }
  .docs-prose h1 {
    font-family: var(--font-serif);
    font-size: 40px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .docs-prose .lede {
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0 0 8px;
    max-width: 640px;
  }
  .docs-updated {
    font-size: 13px;
    color: var(--text-subtle);
    margin: 0 0 24px;
  }
  .docs-prose hr {
    margin: 24px 0 8px;
    border: none;
    border-top: 1px solid var(--border);
  }

  /* TOC column */
  .docs-toc-column { align-self: start; }
  .docs-toc-sticky {
    position: sticky;
    top: 88px;
    font-size: 13px;
  }
  .docs-toc-sticky .toc h3 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-subtle);
    font-weight: 700;
    margin: 0 0 8px;
    padding: 0;
  }

  /* Prev / Next */
  .docs-prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 720px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .docs-pn-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--text);
    transition: all .15s ease;
  }
  .docs-pn-card:hover {
    border-color: var(--brand);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .docs-pn-next { text-align: right; }
  .docs-pn-label {
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 500;
  }
  .docs-pn-title {
    font-weight: 600;
    font-size: 15px;
  }

  /* Callouts (used inside MDX) */
  .callout {
    border-left: 4px solid var(--brand);
    background: var(--bg-tint);
    padding: 14px 18px;
    border-radius: 0 6px 6px 0;
    margin: 20px 0;
  }
  .callout.warning { border-left-color: #d97706; }
  .callout.danger  { border-left-color: #dc2626; }
  .callout.tip     { border-left-color: #059669; }
  .callout-title {
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-bottom: 4px;
    color: var(--text-muted);
  }
  .callout p { margin: 4px 0; }
  .callout p:last-child { margin-bottom: 0; }

  /* Responsive */
  @media (max-width: 1100px) {
    .docs-shell {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 40px;
    }
    .docs-toc-column { display: none; }
  }
  @media (max-width: 780px) {
    .docs-shell {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 24px 16px 60px;
    }
    .docs-sidebar {
      position: static;
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding-right: 0;
      padding-bottom: 20px;
      max-height: none;
    }
    .docs-prev-next { grid-template-columns: 1fr; }
    .docs-prose h1 { font-size: 32px; }
  }
</style>
