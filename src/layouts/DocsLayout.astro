---
import BaseLayout from "./BaseLayout.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import PrevNext from "../components/docs/PrevNext.astro";

interface Props {
  title: string;
  description: string;
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
  updatedDate?: Date;
  group?: string;
}

const { title, description, slug, headings, updatedDate, group } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={`${title} — Docs`} description={description}>
  <div class="docs-shell">
    <DocsSidebar />

    <main class="docs-main">
      <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
        <a href="/docs">Docs</a>
        {group && <><span class="sep">/</span><span class="dim">{group}</span></>}
        <span class="sep">/</span><span class="current">{title}</span>
      </nav>

      <article class="prose docs-prose">
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        {updatedDate && <p class="docs-updated">Updated {fmt(updatedDate)}</p>}
        <slot />
      </article>
      <PrevNext slug={slug} />

      <footer class="docs-page-foot">
        <a href={`https://github.com/asdtransport/ded-blog/edit/main/src/content/docs/${slug}.mdx`} class="docs-edit" target="_blank" rel="noopener">
          Edit this page on GitHub ↗
        </a>
      </footer>
    </main>

    <aside class="docs-toc-column">
      {headings.length > 0 && (
        <div class="docs-toc-sticky">
          <div class="docs-toc-label">On this page</div>
          <TableOfContents headings={headings} />
        </div>
      )}
    </aside>
  </div>
</BaseLayout>

<style is:global>
  /* ─── Docs shell ─────────────────────────────────── */
  .docs-shell {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) 220px;
    gap: 56px;
    padding: 24px 32px 96px;
    align-items: start;
  }

  /* ─── Sidebar ──────────────────────────────────── */
  .docs-sidebar {
    position: sticky;
    top: 80px;
    align-self: start;
    font-size: 13.5px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    padding-right: 12px;
    /* Remove border-right for cleaner MS-style */
  }
  .docs-sidebar-header {
    padding: 8px 8px 16px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: baseline; justify-content: space-between;
  }
  .docs-sidebar-title {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.005em;
  }
  .docs-sidebar-title:hover { color: var(--brand); text-decoration: none; }
  .docs-sidebar-back {
    color: var(--text-subtle);
    font-size: 12px;
  }
  .docs-sidebar-back:hover { color: var(--brand); text-decoration: none; }

  .docs-sidebar-group { margin-bottom: 20px; }
  .docs-sidebar-group-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-subtle);
    margin: 0 0 6px;
    padding: 4px 8px;
  }
  .docs-sidebar-group ul { list-style: none; margin: 0; padding: 0; }
  .docs-sidebar-group li { margin: 0; }

  .docs-sidebar-link {
    display: block;
    padding: 5px 8px 5px 12px;
    color: var(--text-muted);
    border-radius: 4px;
    margin: 1px 0;
    font-size: 13px;
    line-height: 1.45;
    border-left: 2px solid transparent;
  }
  .docs-sidebar-link:hover {
    background: var(--bg-tint);
    color: var(--text);
    text-decoration: none;
  }
  .docs-sidebar-link.active {
    color: var(--brand);
    background: rgba(15,118,110,0.06);
    border-left-color: var(--brand);
    font-weight: 600;
  }

  .docs-sidebar-footer {
    margin-top: 24px;
    padding: 16px 8px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 12px;
  }
  .docs-sidebar-footer a {
    color: var(--text-muted);
    display: block;
    padding: 2px 0;
  }
  .docs-sidebar-footer a:hover { color: var(--brand); }

  /* ─── Main content ─────────────────────────────── */
  .docs-main { min-width: 0; }
  .docs-breadcrumbs {
    font-size: 12.5px;
    color: var(--text-muted);
    margin-bottom: 20px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .docs-breadcrumbs a { color: var(--text-muted); }
  .docs-breadcrumbs a:hover { color: var(--brand); text-decoration: none; }
  .docs-breadcrumbs .sep { color: var(--text-subtle); }
  .docs-breadcrumbs .dim { color: var(--text-muted); }
  .docs-breadcrumbs .current { color: var(--text); font-weight: 500; }

  .docs-prose {
    max-width: 760px;
  }
  .docs-prose h1 {
    font-family: var(--font-sans);
    font-size: 40px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    color: var(--text);
  }
  .docs-prose .lede {
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0 0 8px;
    max-width: 680px;
    font-weight: 400;
  }
  .docs-updated {
    font-size: 12.5px;
    color: var(--text-subtle);
    margin: 0 0 32px;
  }
  .docs-prose > *:first-child + * { margin-top: 12px; }

  /* Prose tuning for docs specifically — tighter, more technical */
  .docs-prose p {
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--text);
    margin: 14px 0;
  }
  .docs-prose h2 {
    font-family: var(--font-sans);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 48px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    line-height: 1.2;
  }
  .docs-prose h3 {
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 600;
    margin: 32px 0 8px;
    line-height: 1.25;
    color: var(--text);
  }
  .docs-prose ul, .docs-prose ol {
    margin: 12px 0;
    padding-left: 24px;
  }
  .docs-prose li {
    font-size: 15.5px;
    line-height: 1.7;
    margin: 6px 0;
  }
  .docs-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    font-size: 14px;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }
  .docs-prose thead th {
    background: var(--bg-tint);
    text-align: left;
    padding: 10px 14px;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }
  .docs-prose tbody td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    vertical-align: top;
  }
  .docs-prose tbody tr:last-child td { border-bottom: none; }
  .docs-prose tbody tr:hover { background: var(--bg-tint); }

  .docs-prose pre {
    background: #0d1117;
    color: #e6edf3;
    padding: 16px 18px;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.55;
    margin: 16px 0;
    border: 1px solid #21262d;
  }
  .docs-prose :not(pre) > code {
    background: var(--bg-tint);
    color: var(--brand);
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 0.9em;
    border: 1px solid var(--border);
  }
  .docs-prose blockquote {
    border-left: 3px solid var(--brand);
    padding: 4px 16px;
    margin: 20px 0;
    color: var(--text);
    background: var(--bg-tint);
    border-radius: 0 4px 4px 0;
  }
  .docs-prose blockquote p { margin: 6px 0; }

  .docs-prose a {
    color: var(--brand);
    text-decoration: none;
    border-bottom: 1px solid rgba(15,118,110,0.25);
    transition: border-color .1s ease;
  }
  .docs-prose a:hover { border-bottom-color: var(--brand); }

  /* Callouts */
  .callout {
    border-left: 4px solid var(--brand);
    background: var(--bg-tint);
    padding: 14px 18px;
    border-radius: 0 6px 6px 0;
    margin: 20px 0;
  }
  .callout.warning { border-left-color: #d97706; background: rgba(217,119,6,0.05); }
  .callout.danger  { border-left-color: #dc2626; background: rgba(220,38,38,0.05); }
  .callout.tip     { border-left-color: #059669; background: rgba(5,150,105,0.05); }
  .callout-title {
    font-weight: 700; font-size: 12px;
    text-transform: uppercase; letter-spacing: 0.5px;
    margin-bottom: 4px; color: var(--text-muted);
  }
  .callout p { margin: 4px 0; font-size: 14.5px; }
  .callout p:last-child { margin-bottom: 0; }

  /* TOC column */
  .docs-toc-column { align-self: start; }
  .docs-toc-sticky { position: sticky; top: 80px; font-size: 13px; }
  .docs-toc-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-subtle);
    font-weight: 700;
    margin-bottom: 8px;
  }
  .docs-toc-sticky .toc h3 { display: none; }
  .docs-toc-sticky .toc a {
    font-size: 12.5px;
    line-height: 1.4;
    padding: 4px 8px;
    border-left: 2px solid transparent;
    color: var(--text-muted);
  }
  .docs-toc-sticky .toc a:hover { color: var(--text); }
  .docs-toc-sticky .toc a.active {
    color: var(--brand);
    border-left-color: var(--brand);
    font-weight: 600;
  }

  /* Prev/Next */
  .docs-prev-next {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
    max-width: 760px; margin-top: 56px;
    padding-top: 20px; border-top: 1px solid var(--border);
  }
  .docs-pn-card {
    border: 1px solid var(--border); border-radius: 8px;
    padding: 12px 16px;
    display: flex; flex-direction: column; gap: 3px;
    color: var(--text); transition: all .15s ease;
    text-decoration: none;
  }
  .docs-pn-card:hover {
    border-color: var(--brand); text-decoration: none;
    transform: translateY(-1px);
  }
  .docs-pn-next { text-align: right; }
  .docs-pn-label { color: var(--text-muted); font-size: 11.5px; font-weight: 500; }
  .docs-pn-title { font-weight: 600; font-size: 14px; }

  /* Page foot */
  .docs-page-foot {
    max-width: 760px;
    margin: 32px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--border);
    font-size: 12.5px;
  }
  .docs-edit { color: var(--text-muted); }
  .docs-edit:hover { color: var(--brand); text-decoration: none; }

  /* Responsive */
  @media (max-width: 1100px) {
    .docs-shell { grid-template-columns: 240px minmax(0, 1fr); gap: 40px; }
    .docs-toc-column { display: none; }
  }
  @media (max-width: 780px) {
    .docs-shell {
      grid-template-columns: 1fr; gap: 24px;
      padding: 20px 16px 60px;
    }
    .docs-sidebar {
      position: static; border-right: none;
      border-bottom: 1px solid var(--border);
      padding: 0 0 20px; max-height: none;
    }
    .docs-prev-next { grid-template-columns: 1fr; }
    .docs-prose h1 { font-size: 30px; }
    .docs-prose h2 { font-size: 22px; }
  }
</style>
