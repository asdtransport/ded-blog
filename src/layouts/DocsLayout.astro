---
import BaseLayout from "./BaseLayout.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import PrevNext from "../components/docs/PrevNext.astro";

interface Props {
  title: string;
  description: string;
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
  updatedDate?: Date;
}

const { title, description, slug, headings, updatedDate } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={`${title} — Docs`} description={description}>
  <div class="docs-shell">
    <DocsSidebar />

    <main class="docs-main">
      <article class="prose docs-prose">
        <div class="docs-eyebrow">Documentation</div>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        {updatedDate && <p class="docs-updated">Updated {fmt(updatedDate)}</p>}
        <hr />
        <slot />
      </article>
      <PrevNext slug={slug} />
    </main>

    <aside class="docs-toc-column">
      {headings.length > 0 && (
        <div class="docs-toc-sticky">
          <TableOfContents headings={headings} />
        </div>
      )}
    </aside>
  </div>
</BaseLayout>
