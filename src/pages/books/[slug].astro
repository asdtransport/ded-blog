---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllBooks, getBookBySlug, getChaptersForBook } from "../../lib/content";

export async function getStaticPaths() {
  const books = await getAllBooks();
  return books.map(b => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const book = await getBookBySlug(slug!);
if (!book) throw new Error(`Book not found: ${slug}`);
const chapters = await getChaptersForBook(slug!);

// Group chapters by `part`
const partGroups: { part: string; chapters: typeof chapters }[] = [];
for (const c of chapters) {
  const partName = c.part || "Chapters";
  const g = partGroups.find(g => g.part === partName);
  if (g) g.chapters.push(c);
  else partGroups.push({ part: partName, chapters: [c] });
}

const totalMinutes = chapters.reduce((sum, c) => sum + (c.readMinutes || 0), 0);
const statusLabel: Record<string, string> = {
  "in-progress": "In progress",
  "published":   "Published",
  "draft":       "Draft",
  "archived":    "Archived",
};
---
<BaseLayout title={`${book.title} — ${book.subtitle || "Book"}`} description={book.description} image={book.cover}>
  <section class="book-hero">
    <div class="book-hero-inner">
      <div class="book-hero-cover">
        {book.cover ? (
          <img src={book.cover} alt={book.title} />
        ) : (
          <div class="book-hero-cover-placeholder">
            <span>{book.title.split(" ").slice(0, 4).map(w => w[0]).join("")}</span>
          </div>
        )}
      </div>
      <div class="book-hero-body">
        <div class="book-hero-meta">
          <span class="book-hero-eyebrow">Book</span>
          <span class="book-hero-status">{statusLabel[book.status]}</span>
        </div>
        <h1>{book.title}</h1>
        {book.subtitle && <p class="book-hero-subtitle">{book.subtitle}</p>}
        <p class="book-hero-desc">{book.description}</p>
        <div class="book-hero-stats">
          <span><strong>{chapters.length}</strong> chapters</span>
          {totalMinutes > 0 && <span>~<strong>{totalMinutes}</strong> min total</span>}
          {book.author && <span>by <strong>{book.author}</strong></span>}
        </div>
        <div class="book-hero-actions">
          {chapters.length > 0 && (
            <a href={`/books/${book.slug}/${chapters[0].slug}`} class="btn btn-primary">
              Read the first chapter →
            </a>
          )}
          {book.buyPdfUrl && book.priceDisplay && (
            <a href={book.buyPdfUrl} class="btn btn-ghost">
              Buy PDF · {book.priceDisplay}
            </a>
          )}
          {!book.buyPdfUrl && book.priceDisplay && (
            <span class="btn btn-ghost" style="opacity:.6;cursor:default;">
              PDF {book.priceDisplay} soon
            </span>
          )}
        </div>
        <div class="book-hero-topics">
          {book.topics.map(t => <span class="tag">{t}</span>)}
        </div>
      </div>
    </div>
  </section>

  {book.aboutHtml && (
    <section class="section">
      <div class="section-inner section-narrow">
        <article class="prose book-about" set:html={book.aboutHtml} />
      </div>
    </section>
  )}

  <section class="section section-tint">
    <div class="section-inner">
      <div class="book-toc-head">
        <h2>Table of contents</h2>
        <p>Read in order or jump around — every chapter stands on its own.</p>
      </div>
      <div class="book-toc">
        {partGroups.map(g => (
          <div class="book-toc-part">
            <div class="book-toc-part-label">{g.part}</div>
            <ol>
              {g.chapters.map(c => (
                <li>
                  <a href={`/books/${book.slug}/${c.slug}`} class="book-toc-link">
                    <span class="book-toc-num">{c.order}</span>
                    <div class="book-toc-info">
                      <div class="book-toc-title">{c.title}</div>
                      {c.description && <div class="book-toc-desc">{c.description}</div>}
                    </div>
                    {c.readMinutes && <span class="book-toc-time">{c.readMinutes} min</span>}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .book-hero {
    background: #171717;
    color: #f5f5f5;
    padding: 64px 24px;
  }
  .book-hero-inner {
    max-width: var(--shell-max); margin: 0 auto;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 48px;
    align-items: start;
  }
  .book-hero-cover {
    aspect-ratio: 3 / 4;
    background: linear-gradient(135deg, var(--brand), #0891b2);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center;
  }
  .book-hero-cover img { width: 100%; height: 100%; object-fit: cover; }
  .book-hero-cover-placeholder {
    color: #fff; font-family: var(--font-serif);
    font-size: 60px; font-weight: 700; letter-spacing: -0.02em;
  }

  .book-hero-body { min-width: 0; }
  .book-hero-meta { display: flex; gap: 10px; align-items: center; margin-bottom: 12px; }
  .book-hero-eyebrow {
    display: inline-block; font-size: 11px; font-weight: 700;
    letter-spacing: 0.6px; text-transform: uppercase; color: var(--brand);
  }
  .book-hero-status {
    font-size: 11px; font-weight: 600; padding: 3px 8px;
    background: rgba(255,255,255,0.1);
    border-radius: 3px; text-transform: uppercase; letter-spacing: 0.5px;
  }
  .book-hero-body h1 {
    font-family: var(--font-serif);
    font-size: 56px; font-weight: 700; margin: 0 0 12px;
    letter-spacing: -0.02em; line-height: 1.05;
    color: #fff;
  }
  .book-hero-subtitle {
    font-family: var(--font-serif); font-style: italic;
    font-size: 20px; color: #d4d4d0; margin: 0 0 20px;
    line-height: 1.4;
  }
  .book-hero-desc {
    color: #d4d4d0; font-size: 16px; line-height: 1.6;
    margin: 0 0 24px; max-width: 620px;
  }
  .book-hero-stats {
    display: flex; gap: 20px;
    color: #a3a3a0; font-size: 14px; margin-bottom: 24px;
  }
  .book-hero-stats strong { color: #fff; font-weight: 700; font-variant-numeric: tabular-nums; }
  .book-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 24px; }
  .book-hero-actions .btn { padding: 12px 22px; font-size: 14px; }
  .book-hero-actions .btn-ghost {
    background: rgba(255,255,255,0.08); color: #fff; border-color: rgba(255,255,255,0.2);
  }
  .book-hero-actions .btn-ghost:hover { background: rgba(255,255,255,0.15); }
  .book-hero-topics { display: flex; flex-wrap: wrap; gap: 4px; }
  .book-hero-topics .tag {
    background: rgba(255,255,255,0.06); color: #d4d4d0;
    border-color: rgba(255,255,255,0.1);
  }

  .book-about h2 {
    font-family: var(--font-serif); font-size: 26px; margin: 32px 0 12px;
  }

  .book-toc-head {
    margin-bottom: 32px;
  }
  .book-toc-head h2 {
    font-family: var(--font-serif);
    font-size: 34px; font-weight: 700; margin: 0 0 8px;
    letter-spacing: -0.015em;
  }
  .book-toc-head p { color: var(--text-muted); margin: 0; font-size: 15px; }

  .book-toc { display: flex; flex-direction: column; gap: 32px; }
  .book-toc-part-label {
    font-family: var(--font-serif);
    font-size: 18px; font-weight: 700; margin-bottom: 14px;
    color: var(--brand);
    letter-spacing: -0.01em;
  }
  .book-toc-part ol {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 4px;
  }

  .book-toc-link {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 14px 18px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    transition: all .15s ease;
  }
  .book-toc-link:hover {
    border-color: var(--brand);
    text-decoration: none;
    transform: translateX(3px);
    box-shadow: var(--shadow-sm);
  }
  .book-toc-num {
    font-family: var(--font-serif);
    font-size: 22px; color: var(--brand); font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .book-toc-info { min-width: 0; }
  .book-toc-title {
    font-size: 15px; font-weight: 600; margin: 0;
    line-height: 1.3;
  }
  .book-toc-desc {
    font-size: 13px; color: var(--text-muted); margin-top: 2px;
    line-height: 1.4;
  }
  .book-toc-time {
    color: var(--text-subtle); font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 820px) {
    .book-hero-inner { grid-template-columns: 1fr; gap: 32px; }
    .book-hero-cover { max-width: 220px; margin: 0 auto; }
    .book-hero-body h1 { font-size: 36px; }
    .book-toc-link { grid-template-columns: 32px 1fr auto; padding: 12px 14px; }
    .book-toc-num { font-size: 18px; }
  }
</style>
