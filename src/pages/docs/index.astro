---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/docs/DocsSidebar.astro";
import { getCollection } from "astro:content";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const gettingStarted = docs.find(d => d.slug === "getting-started");
const groups: Record<string, typeof docs> = {};
for (const d of docs) (groups[d.data.group] ??= []).push(d);
---
<BaseLayout title="Documentation" description="How the ded-blog site is built, and how to add posts, pages, and updates without breaking anything.">
  <div class="docs-shell">
    <DocsSidebar />
    <main class="docs-main">
      <article class="prose docs-prose">
        <div class="docs-eyebrow">Docs</div>
        <h1>ded-blog documentation</h1>
        <p class="lede">
          The runbook for the site: how content flows from Sanity to Cloudflare Pages,
          how to add posts (via Studio or CLI), how to add pages, and what to check when
          something looks off.
        </p>
        <hr />

        {gettingStarted && (
          <p>New here? Start with <a href={`/docs/${gettingStarted.slug}`}><strong>{gettingStarted.data.title}</strong></a>.</p>
        )}

        <h2>By topic</h2>
        <div class="docs-index-grid">
          {Object.entries(groups).map(([group, items]) => (
            <div class="docs-index-group">
              <h3>{group}</h3>
              <ul>
                {items.map(d => (
                  <li>
                    <a href={`/docs/${d.slug}`}>{d.data.title}</a>
                    <span>{d.data.description}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </article>
    </main>
    <aside class="docs-toc-column"></aside>
  </div>
</BaseLayout>

<style>
  .docs-index-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 20px;
  }
  .docs-index-group h3 {
    font-family: var(--font-serif);
    font-size: 18px;
    margin: 0 0 12px;
  }
  .docs-index-group ul { list-style: none; margin: 0; padding: 0; }
  .docs-index-group li {
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  .docs-index-group li a {
    display: block;
    font-weight: 600;
    font-size: 14px;
  }
  .docs-index-group li span {
    display: block;
    color: var(--text-muted);
    font-size: 13px;
    margin-top: 2px;
    line-height: 1.4;
  }
</style>
