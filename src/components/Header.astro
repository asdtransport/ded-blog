---
const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || (href !== "/" && pathname.startsWith(href));
---
<header class="site-header">
  <a href="/" class="brand" aria-label="Derek Ethan Davis — home">
    <span class="brand-mark" aria-hidden="true">D</span>
    <span>derek ethan davis</span>
  </a>
  <nav class="site-nav" aria-label="Primary">
    <a href="/blog" class={isActive("/blog") ? "active" : ""}>Writing</a>
    <a href="/products" class={isActive("/products") ? "active" : ""}>Products</a>
    <a href="/courses" class={isActive("/courses") ? "active" : ""}>Courses</a>
    <a href="/projects" class={isActive("/projects") ? "active" : ""}>Projects</a>
    <a href="/docs" class={isActive("/docs") ? "active" : ""}>Docs</a>
    <a href="/about" class={isActive("/about") ? "active" : ""}>About</a>
  </nav>
  <div class="site-header-right">
    <a href="/rss.xml" class="rss-link" aria-label="RSS feed" title="RSS">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M4 4v3c8.3 0 15 6.7 15 15h3C22 12.1 13.9 4 4 4zm0 6v3c4.9 0 9 4.1 9 9h3c0-6.6-5.4-12-12-12zm2 8a2 2 0 100 4 2 2 0 000-4z"/>
      </svg>
      RSS
    </a>
    <a href="https://github.com/asdtransport" class="rss-link" aria-label="GitHub">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .3a12 12 0 00-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6a4.7 4.7 0 011.3-3.3 4.3 4.3 0 01.1-3.2s1-.3 3.4 1.3a11.6 11.6 0 016.2 0c2.4-1.6 3.4-1.3 3.4-1.3.7 1.7.2 3 .1 3.2a4.7 4.7 0 011.2 3.3c0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0012 .3"/>
      </svg>
    </a>
  </div>
</header>
