---
const path = Astro.url.pathname;
const isActive = (p: string) =>
  p === "/" ? path === "/" : path === p || path.startsWith(p + "/");
---
<header class="site-header" id="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-brand" aria-label="Home">
      <span class="brand-mark" aria-hidden="true">D</span>
      <span class="brand-name">derek ethan davis</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <a href="/blog" class:list={["nav-link", { active: isActive("/blog") }]}>Writing</a>
      <a href="/dedwrong" class:list={["nav-link", { active: isActive("/dedwrong") }]}>Podcast</a>
      <a href="/books" class:list={["nav-link", { active: isActive("/books") }]}>Books</a>
      <a href="/products" class:list={["nav-link", { active: isActive("/products") }]}>Products</a>
      <a href="/courses" class:list={["nav-link", { active: isActive("/courses") }]}>Courses</a>
      <a href="/projects" class:list={["nav-link", { active: isActive("/projects") }]}>Projects</a>
      <a href="/docs" class:list={["nav-link", { active: isActive("/docs") }]}>Docs</a>
      <a href="/about" class:list={["nav-link", { active: isActive("/about") }]}>About</a>
    </nav>

    <div class="site-header-right">
      <a href="/rss.xml" class="header-icon-link" aria-label="RSS feed" title="RSS">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
      </a>
      <a href="https://github.com/asdtransport" class="header-icon-link" aria-label="GitHub" title="GitHub" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.07 3.29 9.37 7.86 10.9.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.69-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.77.12 3.06.74.8 1.19 1.83 1.19 3.09 0 4.43-2.69 5.41-5.26 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.68.8.56C20.22 21.36 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
      </a>
      <a href="/newsletter" class="header-cta">Subscribe</a>
      <button class="mobile-toggle" aria-label="Toggle menu" id="mobile-menu-toggle">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Sticky-header scroll effect + mobile menu
  (function () {
    const header = document.getElementById("site-header");
    const toggle = document.getElementById("mobile-menu-toggle");
    if (!header) return;

    let last = 0;
    const onScroll = () => {
      const y = window.scrollY;
      if (y > 8) header.classList.add("scrolled");
      else header.classList.remove("scrolled");
      last = y;
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    if (toggle) {
      toggle.addEventListener("click", () => {
        header.classList.toggle("menu-open");
      });
    }
  })();
</script>
