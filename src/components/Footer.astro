---
const buildDate = new Date().toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
const buildTime = new Date().toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
// Short commit hash — Cloudflare Pages injects CF_PAGES_COMMIT_SHA at build.
const commitShort = (process.env.CF_PAGES_COMMIT_SHA || "local").slice(0, 7);
const year = new Date().getFullYear();
---
<footer class="site-footer" id="site-footer">
  <div class="site-footer-cta">
    <div class="site-footer-cta-inner">
      <div>
        <div class="footer-eyebrow">Newsletter</div>
        <h3>Notes from the workshop, delivered.</h3>
        <p>Roughly once every couple of weeks. No spam, no growth-hack subject lines. When you get a message from me, you'll want to read it.</p>
      </div>
      <form action="/api/subscribe" method="post" class="footer-nl-form" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Hooked up soon →';">
        <input type="email" name="email" placeholder="you@example.com" required aria-label="Email address" />
        <button type="submit">Subscribe →</button>
      </form>
    </div>
  </div>

  <div class="site-footer-main">
    <div class="site-footer-inner">
      <div class="footer-col footer-brand-col">
        <a href="/" class="footer-brand" aria-label="Home">
          <span class="footer-brand-mark" aria-hidden="true">D</span>
          <div>
            <div class="footer-brand-name">Derek Ethan Davis</div>
            <div class="footer-brand-role">Lead Engineer · Builder</div>
          </div>
        </a>
        <p class="footer-about">Engineer and builder. Notes from an ongoing arc of AI agents, edge infrastructure, MSP tooling, and the occasional philosophy detour.</p>
        <div class="footer-socials">
          <a href="https://github.com/asdtransport" class="footer-social" aria-label="GitHub" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.07 3.29 9.37 7.86 10.9.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.69-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.77.12 3.06.74.8 1.19 1.83 1.19 3.09 0 4.43-2.69 5.41-5.26 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.68.8.56C20.22 21.36 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
          </a>
          <a href="https://twitter.com/derekethandavis" class="footer-social" aria-label="Twitter / X" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://linkedin.com" class="footer-social" aria-label="LinkedIn" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="/rss.xml" class="footer-social" aria-label="RSS">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h5>Read + Listen</h5>
        <a href="/blog">Writing</a>
        <a href="/dedwrong">Podcast</a>
        <a href="/books">Books</a>
        <a href="/topics">Topics</a>
        <a href="/docs">Docs</a>
      </div>

      <div class="footer-col">
        <h5>Shop</h5>
        <a href="/products">Products</a>
        <a href="/courses">Courses</a>
      </div>

      <div class="footer-col">
        <h5>Connect</h5>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/projects">Projects</a>
        <a href="/newsletter">Newsletter</a>
      </div>

      <div class="footer-col">
        <h5>Agents</h5>
        <a href="/rss.xml">RSS feed</a>
        <a href="/dedwrong/rss.xml">Podcast RSS</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="/llms-full.txt">llms-full.txt</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </div>
    </div>

    <div class="site-footer-fine">
      <div class="footer-fine-inner">
        <div>© {year} Derek Ethan Davis</div>
        <div class="footer-build">Built {buildDate}, {buildTime} <code>{commitShort}</code></div>
      </div>
    </div>
  </div>
</footer>
