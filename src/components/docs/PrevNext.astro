---
import { getCollection } from "astro:content";

interface Props { slug: string; }
const { slug } = Astro.props;

const entries = (await getCollection("docs"))
  .sort((a, b) => a.data.order - b.data.order);

const idx = entries.findIndex(e => e.slug === slug);
const prev = idx > 0 ? entries[idx - 1] : null;
const next = idx >= 0 && idx < entries.length - 1 ? entries[idx + 1] : null;
---
{(prev || next) && (
  <nav class="docs-prev-next" aria-label="Docs navigation">
    {prev ? (
      <a href={`/docs/${prev.slug}`} class="docs-pn-card docs-pn-prev">
        <span class="docs-pn-label">← Previous</span>
        <span class="docs-pn-title">{prev.data.title}</span>
      </a>
    ) : <span />}
    {next ? (
      <a href={`/docs/${next.slug}`} class="docs-pn-card docs-pn-next">
        <span class="docs-pn-label">Next →</span>
        <span class="docs-pn-title">{next.data.title}</span>
      </a>
    ) : <span />}
  </nav>
)}
