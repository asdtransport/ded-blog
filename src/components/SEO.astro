---
// SEO — everything a search engine, social crawler, or AI crawler needs.
// Consolidates meta, OpenGraph, Twitter cards, canonical, and JSON-LD.

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  canonical?: string;
  tldr?: string;         // AIO: shows up in AI answer snippets
  keywords?: string[];
}

const {
  title,
  description,
  image = "/og-default.png",
  type = "website",
  pubDate,
  updatedDate,
  author = "Derek Ethan Davis",
  tags = [],
  canonical,
  tldr,
  keywords = [],
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const pageUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const imageUrl = image.startsWith("http") ? image : `${siteUrl}${image}`;
const siteName = "Derek Ethan Davis";
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

// JSON-LD: Article (for posts) or WebSite (for other pages)
const articleSchema = type === "article" && pubDate ? {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  image: imageUrl,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: {
    "@type": "Person",
    name: author,
    url: siteUrl,
  },
  publisher: {
    "@type": "Person",
    name: author,
    url: siteUrl,
  },
  mainEntityOfPage: pageUrl,
  ...(tags.length && { keywords: tags.join(", ") }),
} : null;

const websiteSchema = type !== "article" ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: siteUrl,
  description,
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteUrl}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
} : null;
---

{/* Basics */}
<title>{fullTitle}</title>
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
<link rel="canonical" href={pageUrl} />

{/* AIO / GEO — hint for AI summarizers */}
{tldr && <meta name="tldr" content={tldr} />}

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{type === "article" && <meta property="article:author" content={author} />}
{tags.map(tag => <meta property="article:tag" content={tag} />)}

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:creator" content="@derekethandavis" />

{/* Author + robots */}
<meta name="author" content={author} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

{/* Feeds */}
<link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href={`${siteUrl}/rss.xml`} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

{/* JSON-LD */}
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
{websiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
